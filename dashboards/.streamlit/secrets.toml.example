# Template for Streamlit Cloud secrets (Settings -> Secrets in the
# share.streamlit.io UI). Copy these key/value pairs into the TOML editor;
# do NOT commit a real secrets.toml to git.

# Override paths if the deployed predictions / model live elsewhere.
# Defaults (read by dashboards/churn_dashboard_app.py) already point at
# the repo-relative files: ../outputs/predictions/churn_predictions.csv
# and ../models/churn_model.joblib. Setting CHURN_BASE_DIR is enough for
# Streamlit Cloud because the repo gets mounted at /app.
CHURN_BASE_DIR = "/app"

# Optional — if you decide to call your deployed Flask API from the
# dashboard instead of loading the model joblib in-process, set this:
# FLASK_API_BASE_URL = "https://telechurn-flask.<region>.azurecontainerapps.io"
