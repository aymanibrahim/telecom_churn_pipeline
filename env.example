# .env.example
# ------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Airflow core ──────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=                   # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_SECRET_KEY=changeme-please

# ── SMTP email notifications ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Notification recipients ───────────────────────────────────────────────────
NOTIFY_EMAIL_FROM=airflow@yourdomain.com
NOTIFY_EMAIL_TO=team@yourdomain.com

# ── Slack webhook (optional) ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ── Pipeline DAG schedule ─────────────────────────────────────────────────────
TELECOM_DAG_SCHEDULE=@daily

# ── Flask API ─────────────────────────────────────────────────────────────────
API_KEY=your-secure-api-key           # Leave empty to disable auth (dev only)

# ── Azure Blob Storage (optional, replaces local file storage) ────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_RAW=raw-data
AZURE_CONTAINER_PROCESSED=processed-data
