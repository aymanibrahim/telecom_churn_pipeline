# Copy this file to .env (or export the vars in your shell).
#
# CHURN_BASE_DIR is consumed by src/paths.py.
# AIRFLOW_UID matches the docker-compose airflow user — set this on Linux to
# avoid permission issues with mounted volumes.

# Windows local dev:
# CHURN_BASE_DIR=C:\Users\Lenovo\Downloads\04_requirements

# Docker (already set inside the containers via docker-compose.yaml):
CHURN_BASE_DIR=/opt/airflow/project
AIRFLOW_UID=50000
