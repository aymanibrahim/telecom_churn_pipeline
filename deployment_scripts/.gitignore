outputs/

# Trained model artefacts (regenerated by step 5 of the DAG)
models/*.joblib

# Exception: ship the 100k LightGBM joblib so Streamlit Cloud has a model
# to load on first boot. ~5 MB, fits comfortably in git.
!models/churn_model.joblib

# CSV intermediates / artefacts inside models/
models/*.csv

