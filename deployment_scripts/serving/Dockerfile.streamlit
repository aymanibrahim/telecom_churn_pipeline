# Streamlit dashboard container — slim, just for serving
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY dashboards/requirements-dashboards.txt /tmp/requirements-dashboard.txt
# Override the impossible pins that exist in dashboards/requirements-dashboards.txt
# (pandas==3.0.2 / numpy==2.4.4 don't exist on PyPI; align with serving/).
RUN pip install --no-cache-dir \
    streamlit==1.53.0 \
    pandas==2.2.3 \
    numpy==2.1.3 \
    scikit-learn==1.6.1 \
    lightgbm==4.6.0 \
    category_encoders==2.9.0 \
    imbalanced-learn==0.14.1 \
    joblib==1.5.3 \
    dill==0.3.9 \
    plotly==6.7.0

# Bake the model + a fresh predictions CSV into the image so the dashboard
# works out of the box. The user can replace them via volume mount or env.
COPY models/churn_model.joblib /app/models/churn_model.joblib
COPY outputs/predictions/churn_predictions.csv /app/outputs/predictions/churn_predictions.csv

COPY dashboards /app/dashboards
COPY datasets/telecom_churn/senegal_regions.geojson \
     /app/datasets/telecom_churn/senegal_regions.geojson

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    CHURN_BASE_DIR=/app \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Adjust default sidebar paths so they point at the container's /app tree.
RUN sed -i 's|../outputs/predictions/churn_predictions.csv|/app/outputs/predictions/churn_predictions.csv|g' \
          /app/dashboards/churn_dashboard_app.py \
    && sed -i 's|../models/churn_model.joblib|/app/models/churn_model.joblib|g' \
          /app/dashboards/churn_dashboard_app.py

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "dashboards/churn_dashboard_app.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501"]
