# Flask REST API container — slim runtime (no Airflow, no dask, no geopandas)
FROM python:3.11-slim

# OS deps for lightgbm (libgomp) + curl for healthchecks
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY serving/requirements-flask.txt /tmp/requirements-flask.txt
RUN pip install --no-cache-dir -r /tmp/requirements-flask.txt

# Bake the model into the image as a fallback (the runtime can still
# override via AZURE_BLOB_URL or CHURN_MODEL_PATH).
COPY models/churn_model.joblib /app/models/churn_model.joblib

COPY serving/flask_app.py /app/serving/flask_app.py
COPY src /app/src

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=5000

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:5000/health || exit 1

CMD ["gunicorn", "--workers=2", "--threads=4", "--timeout=120", \
     "--bind=0.0.0.0:5000", "--access-logfile=-", \
     "serving.flask_app:app"]
